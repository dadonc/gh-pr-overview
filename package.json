{
  "name": "github-pr-overview",
  "description": "Adds compact review-thread, diff, and AI-agent summaries alongside GitHub's native pull request comment counts.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "generate:icons": "node scripts/verify-disabled-icons.mjs --write",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run test:coverage && npm run compile && npm run build && npm run verify:manifest && npm run verify:icons && npm run verify:bundle && npm run test:e2e",
    "test:watch": "vitest",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:icons": "node scripts/verify-disabled-icons.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@wxt-dev/module-react": "^1.1.5",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wxt": "^0.20.27"
  }
}
